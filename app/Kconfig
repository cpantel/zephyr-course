menu "Local configuration"

config LED_SUBSYSTEM
  bool "LED Subsystem"
  default y
  help 
    Enables LED subsystem
  if LED_SUBSYSTEM
    choice
      prompt "LED blink sleep time"
        
      default LED_BLINKING_PERIOD_1000MS
      config LED_BLINKING_PERIOD_250MS
        bool "250ms (too fast)"
      config LED_BLINKING_PERIOD_500MS
        bool "500ms (fast)"
      config LED_BLINKING_PERIOD_1000MS
        bool "1s (medium)"
      config LED_BLINKING_PERIOD_2000MS
        bool "2s (slow)"
    endchoice
  
    config LED_BLINKING_PERIOD
      int   #hidden
      default  250 if LED_BLINKING_PERIOD_250MS
      default  500 if LED_BLINKING_PERIOD_500MS
      default 1000 if LED_BLINKING_PERIOD_1000MS
      default 2000 if LED_BLINKING_PERIOD_2000MS
    menuconfig LED_ADVANCED
      bool "Advanced LED settings"
      if LED_ADVANCED  
        config LED_BRIGHTNESS
          int "LED brightness"
          default 100
          range 0 100
        config LED_FADE_DURATION
          int "LED fade duration"
          default 500
          range 0 5000
      endif
        menu "Expert settings"
          visible if LED_ADVANCED
          config LED_DEBUGGING
            bool "Enable LED debugging"
          config LED_CUSTOM
            bool "Custom blink pattern"
            if LED_CUSTOM
              config LED_PATTERN_BIT_0
                bool "Bit 0"
              config LED_PATTERN_BIT_1
                bool "Bit 1"
              config LED_PATTERN_BIT_2
                bool "Bit 2"
              config LED_PATTERN_BIT_3
                bool "Bit 3"
              config LED_PATTERN_BIT_4
                bool "Bit 4"
              config LED_PATTERN_BIT_5
                bool "Bit 5"
              config LED_PATTERN_BIT_6
                bool "Bit 6"
              config LED_PATTERN_BIT_7
                bool "Bit 7"
            endif
        endmenu
  endif
endmenu

menu "Zephyr configuration"
  source "Kconfig.zephyr"
endmenu
